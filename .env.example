# LaneReach configuration. Copy to .env for local development. Every setting is read from the
# environment (case-insensitive); in staging/production secrets come from Azure Key Vault.

# --- Runtime ---------------------------------------------------------------------------------
# local | test | development | staging | production
ENVIRONMENT=local
SERVICE_NAME=lanereach-api
LOG_LEVEL=INFO
# JSON logs (true) or human-readable console logs (false)
LOG_JSON=true
API_PREFIX=/api/v1
# JSON list. Empty = CORS closed (no frontend yet).
CORS_ALLOWED_ORIGINS=[]
MAX_REQUEST_BODY_BYTES=1048576
PROBLEM_TYPE_BASE_URI=urn:lanereach:problem:

# --- Database --------------------------------------------------------------------------------
# App role: owns nothing, no BYPASSRLS. Used by the API and workers.
DATABASE_URL=postgresql+asyncpg://lanereach_app:lanereach_app@localhost:15432/lanereach
# Owner role: owns the tables, runs Alembic migrations.
DATABASE_OWNER_URL=postgresql+asyncpg://lanereach_owner:lanereach_owner@localhost:15432/lanereach
# Superuser URL, only used by `lanereach-admin bootstrap-db` to create the two roles above.
DATABASE_ADMIN_URL=postgresql://postgres:postgres@localhost:15432/lanereach
DATABASE_POOL_SIZE=10
DATABASE_ECHO=false

# --- Redis / Celery --------------------------------------------------------------------------
REDIS_URL=redis://localhost:16379/0
CELERY_BROKER_URL=redis://localhost:16379/1

# --- Auth ------------------------------------------------------------------------------------
# oidc (staging/production) | dev (local/tests). dev is refused when ENVIRONMENT=production.
AUTH_MODE=dev
# HS256 secret for dev tokens; at least 32 characters.
DEV_TOKEN_SECRET=change-me-dev-only-secret-at-least-32-bytes
DEV_TOKEN_ISSUER=lanereach-dev
DEV_TOKEN_MAX_LIFETIME_SECONDS=86400
# Audience every accepted JWT must carry (the API's app registration).
JWT_AUDIENCE=api://lanereach
JWT_LEEWAY_SECONDS=30
# Claim holding the IdP tenant/org ID (Entra: tid) and the roles (Entra app roles: roles).
OIDC_TENANT_CLAIM=tid
OIDC_ROLES_CLAIM=roles
OIDC_JWKS_CACHE_TTL_SECONDS=3600
OIDC_JWKS_MIN_REFRESH_INTERVAL_SECONDS=60
OIDC_HTTP_TIMEOUT_SECONDS=5
API_KEY_LAST_USED_WRITE_INTERVAL_SECONDS=60

# --- Webhooks --------------------------------------------------------------------------------
# JSON object: sending provider name -> HMAC signing secret.
WEBHOOK_SIGNING_SECRETS={"dry_run": "whsec_local_dev_only"}
WEBHOOK_SIGNATURE_TOLERANCE_SECONDS=300

# --- Idempotency -----------------------------------------------------------------------------
IDEMPOTENCY_KEY_TTL_SECONDS=86400

# --- Automation engine -----------------------------------------------------------------------
MAX_COLD_EMAILS_PER_SEQUENCE=3
MAX_STEPS_PER_TICK=20
ENGINE_BATCH_SIZE=100
# How often Celery beat runs the dispatcher (safety net behind after-commit enqueueing).
ENGINE_DISPATCH_INTERVAL_SECONDS=30
# celery (API + worker) | inline (single process, tests/demos without a worker)
TASK_QUEUE=celery

# --- Guardrails ------------------------------------------------------------------------------
FREQUENCY_CAP_DAYS=30
KILL_SWITCH_RECHECK_MINUTES=15

# --- Sending and notifications ---------------------------------------------------------------
# dry_run (default): emails are written to the outbox table, nothing leaves the system.
# smtp: every agent sends through their own mailbox (connect it in Agents → Mailbox and test it);
# agents without a verified mailbox are held by the `mailbox_connected` guardrail.
SENDING_PROVIDER=dry_run
# Real sending: queued emails are delivered this often; replies are read from the mailboxes (IMAP).
OUTBOX_DELIVERY_INTERVAL_SECONDS=15
MAILBOX_POLL_INTERVAL_SECONDS=60
MAIL_TIMEOUT_SECONDS=20
# Base URL used in List-Unsubscribe links.
PUBLIC_BASE_URL=http://127.0.0.1:8080

# --- Scripts library (Word scripts, banners) -----------------------------------------------
# Development stand-in for SharePoint: a folder with the same layout (Scripts/, Banners/, Brand/).
LOCAL_DOCUMENTS_PATH=var/documents
# JSON object: tenant slug -> client secret of the tenant's Azure AD app (Graph Sites.Selected).
# The site, library, Azure tenant ID and client ID are set per tenant in Settings > Scripts library.
SHAREPOINT_CLIENT_SECRETS={}
# How often every tenant's library is synced (seconds).
SCRIPT_SYNC_INTERVAL_SECONDS=300
# Largest Word/PDF/image upload accepted (bytes).
MAX_UPLOAD_BYTES=10485760
# Signs unsubscribe links. Staging/production refuse to start with this default (32+ chars).
UNSUBSCRIBE_SIGNING_SECRET=change-me-unsubscribe-secret
# JSON object: Teams channel name -> incoming webhook URL (optional).
TEAMS_WEBHOOK_URLS={}
PRICING_NOTIFICATION_RECIPIENT=pricing-team

# --- Console sign-in (AUTH_MODE=oidc) ------------------------------------------------------
# Microsoft Entra ID: register a single-page app with redirect URI <console>/auth/callback.
OIDC_AUTHORITY=
OIDC_CLIENT_ID=
OIDC_SCOPES=openid profile email api://lanereach/access_as_user
OIDC_PROVIDER_NAME=Microsoft

# --- Integrations (webhooks, Slack, Calendly / Cal.com, verification, forms) ----------------
# Fernet key encrypting integration secrets. Required in staging/production. Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
INTEGRATIONS_ENCRYPTION_KEY=
# Development only: allow http:// and private addresses for a local webhook receiver.
INTEGRATIONS_ALLOW_PRIVATE_URLS=false
INTEGRATION_DELIVERY_INTERVAL_SECONDS=30
# Console address used in links of Slack alerts.
CONSOLE_BASE_URL=http://localhost:8081
FORM_SUBMISSIONS_PER_EMAIL_PER_HOUR=5
FORM_SUBMISSIONS_PER_FORM_PER_MINUTE=30
# Public website: "Contact us" posts to this web form (create it under Website forms in your own
# tenant; enquiries arrive as contacts). Without it the page shows PUBLIC_CONTACT_EMAIL.
PUBLIC_CONTACT_FORM_KEY=
PUBLIC_CONTACT_EMAIL=
# "Try it with your own email" on the website (real LLM calls by anonymous visitors, rate limited).
PUBLIC_AI_DEMO=false
PUBLIC_AI_DEMO_PER_IP_PER_MINUTE=3
PUBLIC_AI_DEMO_PER_MINUTE=20
# Requests per minute per visitor to the online quote pages (links in quote emails).
QUOTE_ONLINE_PER_IP_PER_MINUTE=30

# --- LLM -------------------------------------------------------------------------------------
# mock (deterministic heuristics, no key needed) | anthropic | azure_openai
LLM_PROVIDER=mock
# Model ID for the anthropic provider, for example claude-opus-5 (never hardcoded in code).
LLM_MODEL=
LLM_TIMEOUT_SECONDS=60
LLM_MAX_RETRIES=2
# Claude output_config.effort: low suits classification/extraction.
LLM_EFFORT=low
LLM_CIRCUIT_BREAKER_FAILURES=5
LLM_CIRCUIT_BREAKER_RESET_SECONDS=60
# Used to estimate cost on AI runs (USD per million tokens).
LLM_PRICE_INPUT_PER_MTOK=0
LLM_PRICE_OUTPUT_PER_MTOK=0
# Optional cheaper model for the reading tasks (sorting replies, shipment details, buying intent,
# summaries, rate-lane matching), for example claude-haiku-5-5; writing keeps LLM_MODEL. Its prices
# cost those runs. Each company can also set a monthly AI budget in Settings -> AI usage.
LLM_MODEL_LIGHT=
LLM_LIGHT_PRICE_INPUT_PER_MTOK=0
LLM_LIGHT_PRICE_OUTPUT_PER_MTOK=0
ANTHROPIC_API_KEY=
# Server-side refusal fallback (beta): a refused request is re-run on a fallback model.
ANTHROPIC_REFUSAL_FALLBACK=true
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_API_VERSION=2024-10-21
AZURE_OPENAI_DEPLOYMENT=
# Optional cheaper deployment for the reading tasks (like LLM_MODEL_LIGHT).
AZURE_OPENAI_DEPLOYMENT_LIGHT=
# Assistant search: none (PostgreSQL full-text only, default), azure_openai (vectors from the
# embeddings deployment below, e.g. text-embedding-3-small) or mock (tests / key-less development).
EMBEDDINGS_PROVIDER=none
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=

# --- AI behaviour ----------------------------------------------------------------------------
# Below this confidence a classification goes to human review.
AI_REVIEW_CONFIDENCE_THRESHOLD=0.80
# Email bodies, AI outputs and review payloads older than this are purged daily (rows are kept).
DATA_RETENTION_DAYS=365
RETENTION_PURGE_INTERVAL_SECONDS=86400
# AI endpoint budgets (requests per minute; 0 disables). Counted in Redis.
AI_RATE_LIMIT_PER_TENANT_PER_MINUTE=300
AI_RATE_LIMIT_PER_CALLER_PER_MINUTE=60
# Reply handling: "later" re-enrolls after N days; "not interested" rests the contact.
LATER_REENROLL_DAYS=60
NOT_INTERESTED_REST_DAYS=180
# Out-of-office without a return date: resume after N days.
OUT_OF_OFFICE_DEFAULT_DAYS=7
# Soft bounces: retry after N hours; the Nth within the window suppresses permanently.
SOFT_BOUNCE_RETRY_HOURS=24
SOFT_BOUNCE_LIMIT=3
SOFT_BOUNCE_WINDOW_DAYS=30
# make eval fails below these.
EVAL_MIN_BUCKET_ACCURACY=0.80
EVAL_MIN_EXTRACTION_ACCURACY=0.70

# --- Docker Compose host ports (only read by docker-compose.yml) ----------------------------
LANEREACH_API_PORT=8080
# The console (React app + API proxy).
LANEREACH_WEB_PORT=8081
LANEREACH_POSTGRES_PORT=15432
LANEREACH_REDIS_PORT=16379
LANEREACH_ADMIN_DB_PASSWORD=postgres
LANEREACH_OWNER_DB_PASSWORD=lanereach_owner
LANEREACH_APP_DB_PASSWORD=lanereach_app

# Sales intelligence: days without activity that make a deal quiet; AI follow-up suggestions per tenant per day.
QUIET_DEAL_DAYS=5
FOLLOW_UP_SUGGESTIONS_PER_RUN=20
